{
    "extends": [
        "github>thekevjames/tools:personal",
    ],
    "customManagers": [
        // Usage:
        //     # renovate: datasource=github-releases depName=owner/repo
        //     TAG="v1.2.3"
        {
            "description": "Update pinned versions in bin/ scripts",
            "managerFilePatterns": [
                "/^bin/[^/]+$/",
            ],
            "customType": "regex",
            "matchStrings": [
                "# renovate: datasource=(?<datasource>[a-z-]+?) depName=(?<depName>.+?)(?: versioning=(?<versioning>[a-z-]+?))?\\s+[A-Z_]+=\"?(?<currentValue>[^\"\\s]+)\"?\\s",
            ],
            "versioningTemplate": "{{#if versioning}}{{versioning}}{{else}}semver{{/if}}",
        },
    ],
    "packageRules": [
        {
            // N.B. generally requires re-running the script manually
            "matchManagers": ["custom.regex"],
            "matchFileNames": ["bin/**"],
            "automerge": false,
        },
        {
            // task's tags are PEP 440 (eg. 9.0.0rc2), which semver cannot read
            "matchManagers": ["pep621"],
            "matchDepNames": ["task"],
            "versioning": "pep440",
        },
        {
            // N.B. pi/patches/ is keyed to the exact version: carry it forward by hand
            "matchDepNames": ["@anthropic-ai/sandbox-runtime"],
            "automerge": false,
        },
    ],
}
