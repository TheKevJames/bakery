#!/usr/bin/env bash
set -euo pipefail

cd "$(git -C "$(dirname "$0")" rev-parse --show-toplevel)"

declare -A REPO_SOURCES
declare -A REPO_FOLDERS

# Vendor a single file: $1 local path, $2 remote path, $3 repo, $4 sha
vendor_file() {
    local fname="$1" rpath="$2" repo="$3" sha="$4"
    echo "Updating ${fname} from ${repo}..."
    mkdir -p "$(dirname "${fname}")"

    local url="https://raw.githubusercontent.com/${repo}/${sha}/${rpath}"
    curl -s "${url}" > "${fname}"
}

declare -A SOURCES
declare -A FOLDERS

SOURCES=()
FOLDERS=()
FOLDERS["pi/skills/vendor/codebase-design"]="skills/engineering/codebase-design"
FOLDERS["pi/skills/vendor/domain-modeling"]="skills/engineering/domain-modeling"
FOLDERS["pi/skills/vendor/grill-with-docs"]="skills/engineering/grill-with-docs"
FOLDERS["pi/skills/vendor/grilling"]="skills/productivity/grilling"
FOLDERS["pi/skills/vendor/improve-codebase-architecture"]=\
"skills/engineering/improve-codebase-architecture"
FOLDERS["pi/skills/vendor/wizard"]="skills/engineering/wizard"
# TODO: version management
REPO_SOURCES["mattpocock/skills:v1.2.3"]=$(declare -p SOURCES)
REPO_FOLDERS["mattpocock/skills:v1.2.3"]=$(declare -p FOLDERS)

for repo_ref in "${!REPO_SOURCES[@]}"; do
    repo="${repo_ref%:*}"
    branch="${repo_ref##*:}"
    SHA=$(gh api "repos/${repo}/commits/${branch}" -q '.sha')

    eval "${REPO_SOURCES["${repo_ref}"]}"
    for fname in "${!SOURCES[@]}"; do
        vendor_file "${fname}" "${SOURCES[${fname}]}" "${repo}" "${SHA}"
    done

    eval "${REPO_FOLDERS["${repo_ref}"]}"
    if [ "${#FOLDERS[@]}" -gt 0 ]; then
        TREE=$(gh api "repos/${repo}/git/trees/${SHA}?recursive=1" \
            -q '.tree[] | select(.type=="blob") | .path')
        for local_dir in "${!FOLDERS[@]}"; do
            remote_dir="${FOLDERS[${local_dir}]%/}"
            while IFS= read -r rpath; do
                [ -z "${rpath}" ] && continue
                vendor_file "${local_dir}/${rpath#"${remote_dir}"/}" \
                    "${rpath}" "${repo}" "${SHA}"
            done < <(grep "^${remote_dir}/" <<< "${TREE}" || true)
        done
    fi
done

# normalize any whitespace/etc
prek run -a
